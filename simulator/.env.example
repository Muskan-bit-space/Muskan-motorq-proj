# Vehicle Simulator Configuration

# Backend URL (default: local development)
BACKEND_URL=http://localhost:5000

# Telemetry endpoint
TELEMETRY_ENDPOINT=/api/v1/telemetry

# Simulation interval in milliseconds (1000 = 1 second)
SIMULATION_INTERVAL=1000

# Number of vehicles to simulate
VEHICLE_COUNT=4

# Log level: debug, info, warn, error
LOG_LEVEL=info